{
	"compilerOptions": {
		"target": "es2017",
		"lib": ["es2017", "dom"],
		"module": "commonjs",
		"moduleResolution": "node",
		"strict": true,
		"noImplicitReturns": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": ".",
		"types": [],
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "example/**/*.ts"]
}
